# Ordinary PostgreSQL and Supabase connection strings are supported.
# Supabase example: postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/crypto_news
OPENAI_ANALYSIS_MODEL=gpt-5-nano
OPENAI_VALIDATION_MODEL=gpt-5-mini
OPENAI_MAX_ARTICLE_TOKENS=900
OPENAI_MAX_OUTPUT_TOKENS=140
LOG_LEVEL=INFO
BINANCE_BASE_URL=https://api.binance.com
CRAWLER_USER_AGENT=CryptoNewsResearchBot/1.0
