# Server-only Supabase Data API credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-sb-secret-key
# Legacy alternative only: SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Canonical production origin. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used
# as a fallback when this is omitted. Never use a preview deployment URL.
SITE_URL=https://your-production-domain.example

# Read-only historical API V1. Generate a dedicated random value with at least
# 32 characters; never reuse an OpenAI, Supabase, or Vercel credential.
CMR_API_KEY=replace-with-a-dedicated-random-api-key
CMR_API_RATE_LIMIT_PER_MINUTE=60
CMR_API_DAILY_LIMIT=10000

# Safe local defaults. Production must explicitly enable the feature and use
# production/openai/distributed values; it never falls back to fixtures/mock.
AI_SEARCH_ENABLED=false
AI_SEARCH_DATA_ADAPTER=fixture
AI_SEARCH_PROVIDER=mock
AI_SEARCH_USE_DISTRIBUTED_RATE_LIMITER=false
AI_SEARCH_PER_IP_LIMIT=10
AI_SEARCH_DAILY_LIMIT=500
AI_SEARCH_MAX_COST_USD=0.01
AI_GENERAL_MAX_COST_USD=0.015
OPENAI_AI_SEARCH_MODEL=gpt-5-mini
# OPENAI_API_KEY=your-server-only-api-key

# Paid evaluation is separately opt-in and budgeted.
AI_LIVE_TESTS=0
AI_LIVE_TEST_BUDGET_USD=0.05
