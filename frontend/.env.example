# Server-only Supabase Data API credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-sb-secret-key
# Legacy alternative only: SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Canonical production origin. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used
# as a fallback when this is omitted. Never use a preview deployment URL.
SITE_URL=https://your-production-domain.example
